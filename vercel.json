{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {"type": "header", "key": "host", "value": "guidedevoyage-voyages1\\.vercel\\.app"}
      ],
      "destination": "https://nord-7m4q9k2p.vercel.app/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {"type": "header", "key": "host", "value": "guidedevoyage-git-main-voyages1\\.vercel\\.app"}
      ],
      "destination": "https://nord-7m4q9k2p.vercel.app/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet"},
        {"key": "Permissions-Policy", "value": "geolocation=(self), accelerometer=(self), gyroscope=(self), magnetometer=(self)"},
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {"key": "Cache-Control", "value": "no-store, no-cache, must-revalidate"}
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {"key": "Cache-Control", "value": "no-store, no-cache, must-revalidate"}
      ]
    },
    {
      "source": "/header-prestige.js",
      "headers": [
        {"key": "Cache-Control", "value": "no-store, no-cache, must-revalidate"}
      ]
    }
  ]
}
